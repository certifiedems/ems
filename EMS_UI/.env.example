# ems_frontend/.env.example
#
# Copy to `.env` (or set these in the hosting provider's build settings) and
# rebuild. Vite inlines VITE_* variables at build time, so a change here needs a
# redeploy to take effect.

# Frontend-side maintenance override.
#
# Holds every visitor on the maintenance screen no matter what the backend
# reports. Use it only for work the backend cannot announce because it is the
# thing being replaced — a host migration, a DNS cutover, an API swap.
#
# For ordinary planned downtime prefer the backend's MAINTENANCE_MODE variable
# instead: it needs no frontend rebuild, and it lifts the moment it is unset.
VITE_MAINTENANCE_MODE=false

# Optional copy for the screen above. Falls back to a generic line when unset.
VITE_MAINTENANCE_MESSAGE=
