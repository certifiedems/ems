# Copy to .env and fill in real values. .env is gitignored.
POSTGRES_PASSWORD=
JWT_SECRET=

# Cloudflare R2 — dashboard > R2 > Manage R2 API Tokens
# R2_ACCOUNT_ID is the hex prefix of the S3 endpoint:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=ems-profile-photos
